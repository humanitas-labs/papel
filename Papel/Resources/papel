#!/bin/sh
# papel — open files in Papel from the terminal.
#
# Usage:
#   papel                open Papel
#   papel file.md …      open files, creating any that do not exist yet
#   papel --help         this text
#   papel --version      the version of the app the command belongs to
#   papel --set-default  make Papel the app that opens Markdown files
#
# The script lives at Papel.app/Contents/Resources/papel and finds the
# app from its own real location, so a symlink on the PATH works from
# anywhere. Settings ▸ CLI puts one there; by hand:
#   ln -s /Applications/Papel.app/Contents/Resources/papel /usr/local/bin/papel

usage() {
  cat <<'EOF'
usage: papel [file ...]
       papel --help | --version | --set-default

Opens files in Papel, creating any that do not exist yet. With no
arguments, opens the app. --set-default makes Papel the app that
opens Markdown files.
EOF
}

self="$0"
resolved="$(readlink -f "$self" 2>/dev/null)" && self="$resolved"
app="$(cd "$(dirname "$self")/../.." 2>/dev/null && pwd)"
case "$app" in
  *.app) ;;
  *) app="/Applications/Papel.app" ;;
esac

case "$1" in
  -h|--help)
    usage
    exit 0 ;;
  -V|--version)
    /usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null \
      || { echo "papel: no app at $app" >&2; exit 1; }
    exit 0 ;;
  --set-default)
    # The app itself asks Launch Services; run its executable directly so
    # it answers and exits even while another copy is open.
    exe="$app/Contents/MacOS/Papel"
    [ -x "$exe" ] || { echo "papel: no app at $app" >&2; exit 1; }
    exec "$exe" --set-default ;;
  --)
    shift ;;
esac

if [ ! -f "$app/Contents/Info.plist" ]; then
  echo "papel: no app at $app" >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  exec open -a "$app"
fi

# Absolute paths: open resolves them regardless of its own directory, and
# none can start with a dash, so touch and open never read one as a flag.
count="$#"
for f in "$@"; do
  case "$f" in
    /*) ;;
    *) f="$PWD/$f" ;;
  esac
  if [ ! -e "$f" ]; then
    touch "$f" || exit 1
  fi
  set -- "$@" "$f"
done
shift "$count"
exec open -a "$app" "$@"
